# Environment variables for SAPA — Sistem Akademik Pesantren Terpadu
# Copy file ini menjadi .env dan sesuaikan nilainya dengan konfigurasi server Anda

# =======================================================================
# DATABASE (WAJIB)
# =======================================================================
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Contoh untuk aaPanel dengan MariaDB lokal:
DATABASE_URL="mysql://sapa_user:password_kuat@127.0.0.1:3306/sapa_db"

# =======================================================================
# JWT SECRET (SANGAT DISARANKAN diubah dari nilai default)
# =======================================================================
# Gunakan string acak yang panjang dan unik (min. 32 karakter)
# Cara generate: openssl rand -base64 32
JWT_SECRET="ganti_dengan_secret_yang_sangat_panjang_dan_acak"

# =======================================================================
# NODE ENVIRONMENT
# =======================================================================
NODE_ENV="production"
