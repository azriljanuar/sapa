generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN_JENJANG
  GURU
  SANTRI
}

enum SemesterNama {
  GANJIL
  GENAP
}

model User {
  id        Int                @id @default(autoincrement())
  nama      String
  email     String             @unique
  password  String
  role      Role
  jenjangId Int?
  jenjang   JenjangPendidikan? @relation(fields: [jenjangId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([jenjangId])
}

model JenjangPendidikan {
  id                 Int             @id @default(autoincrement())
  nama               String
  singkatan          String
  
  // Profil Jenjang
  npsn               String?
  namaKepalaMadrasah String?
  nipKepalaMadrasah  String?
  alamat             String?         @db.Text
  telepon            String?
  email              String?
  logoUrl            String?         @db.Text
  iconUrl            String?         @db.Text
  kopSuratUrl        String?         @db.Text
  templateSKL        String?         @db.Text
  
  // Pengaturan Absensi
  waktuMulaiAbsen    String?         // Format: HH:mm (misal: "05:00")
  waktuAkhirAbsen    String?         // Format: HH:mm (misal: "08:00")

  users              User[]
  santriJenjang      SantriJenjang[]
  kelas              KelasFormal[]
  gurus              Guru[]          @relation("GuruJenjangs")
  sarpras            SarprasJenjang[]
  mataPelajaran      MataPelajaran[]
  templateKartu      TemplateKartu[]
  hariLibur          HariLibur[]
  guruPiket          GuruPiket[]
}

model TahunAjaran {
  id          Int           @id @default(autoincrement())
  nama        String        @unique
  isActive    Boolean       @default(false)
  semester    Semester[]
  kelasFormal KelasFormal[]
  pengampu    PengampuMataPelajaran[]
  santriMasuk SantriJenjang[]       @relation("TahunMasuk")
  santriLulus SantriJenjang[]       @relation("TahunLulus")
  santriMasukDirect Santri[]        @relation("SantriTahunMasuk")
  santriLulusDirect Santri[]        @relation("SantriTahunLulus")
  guruPiket         GuruPiket[]
}

model Semester {
  id            Int          @id @default(autoincrement())
  nama          SemesterNama
  tahunAjaranId Int
  tahunAjaran   TahunAjaran  @relation(fields: [tahunAjaranId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  isActive      Boolean      @default(false)
  nilaiDirilis  Boolean      @default(false) // Toggle global rilis nilai satu semester

  @@unique([tahunAjaranId, nama])
  jadwalPelajaran JadwalPelajaran[]
  kehadiranGuru   KehadiranGuru[]
  kehadiranSantri KehadiranHarianSantri[]
  laporanSemester LaporanSemester[]
  nilaiSumatif    NilaiSumatif[]
  nilaiPAS        NilaiPAS[]
}

model Guru {
  id                 Int                 @id @default(autoincrement())
  nama               String
  nip                String?             @unique
  email              String              @unique
  rfidCardId         String?             @unique // UID Kartu RFID Guru
  password           String              @default("$2b$10$qTWxb4MAxuVYju.SFeZrreZMKo/9OfBaxs4WpB7x.9geRPxTdNQtq") // default: password123
  
  niPPPK             String?
  nuptk              String?
  nik                String?
  tempatLahir        String?
  tanggalLahir       DateTime?
  jenisKelamin       String?
  agama              String?
  alamatLengkap      String?             @db.Text
  noTelepon          String?
  pendidikanTerakhir String?
  jurusan            String?
  statusPegawai      String?
  tmt                DateTime?
  namaIbuKandung     String?
  fotoWajah          String?             @db.Text

  jenjangs           JenjangPendidikan[] @relation("GuruJenjangs")
  waliKelas          KelasFormal[]
  pengampu           PengampuMataPelajaran[]
  kehadiran          KehadiranGuru[]
  piket              GuruPiket[]
}

enum StatusSantri {
  AKTIF
  ALUMNI
  MUTASI
  KELUAR
}

model Santri {
  id               Int               @id @default(autoincrement())
  nisn             String            @unique
  rfidCardId       String?           @unique // UID Kartu RFID Santri
  password         String            @default("$2b$10$qTWxb4MAxuVYju.SFeZrreZMKo/9OfBaxs4WpB7x.9geRPxTdNQtq") // default: password123
  
  namaLengkap      String
  nik              String?
  tempatLahir      String?
  tanggalLahir     DateTime?
  jenisKelamin     String?
  alamat           String?           @db.Text
  noTelepon        String?
  kebutuhanKhusus  String?
  disabilitas      String?
  noKipPip         String?
  namaAyah         String?
  namaIbu          String?
  fotoWajah        String?           @db.Text

  riwayatKesehatan String?           @db.Text

  // Status & Keaktifan Langsung (Single-Jenjang)
  status           StatusSantri      @default(AKTIF)
  statusMukim      Boolean           @default(false)

  // Data Mutasi / Keluar
  statusKeluar     StatusKeluar?
  namaSekolahTujuan String?          @db.Text
  tanggalPindah    DateTime?
  alasanPindah     String?           @db.Text

  // Data Akademik & Alumni Langsung
  tahunMasukId     Int?
  tahunMasuk       TahunAjaran?      @relation("SantriTahunMasuk", fields: [tahunMasukId], references: [id], onDelete: SetNull)
  tahunLulusId     Int?
  tahunLulus       TahunAjaran?      @relation("SantriTahunLulus", fields: [tahunLulusId], references: [id], onDelete: SetNull)
  keteranganLulus  String?           @db.Text
  statusLanjutan   StatusLanjutan?
  namaInstansi     String?           @db.Text
  programStudi     String?
  kotaDomisiliSekarang String?
  kontakWA         String?
  emailAlumni      String?

  // Relasi lain
  jenjangs         SantriJenjang[]
  riwayatKelas     RiwayatKelas[]
  kehadiranHarian  KehadiranHarianSantri[]
  absensiMapel     AbsensiMapel[]
  pengumpulanTugas PengumpulanTugas[]
  nilaiSumatif     NilaiSumatif[]
  nilaiPAS         NilaiPAS[]
  laporanSemester  LaporanSemester[]
}

enum StatusLanjutan {
  KULIAH
  KERJA
  WIRAUSAHA
  TIDAK_LANJUT
  LAINNYA
}

enum StatusKeluar {
  PINDAH_SEKOLAH
  MENGUNDURKAN_DIRI
  DIKELUARKAN
}

model SantriJenjang {
  id               Int               @id @default(autoincrement())
  santriId         Int
  jenjangId        Int
  
  statusMukim      Boolean           @default(false)
  isAlumni         Boolean           @default(false)
  
  // Status Keluar (non-alumni)
  statusKeluar      StatusKeluar?
  namaSekolahTujuan String?         @db.Text
  tanggalPindah     DateTime?
  alasanPindah      String?         @db.Text

  tahunMasukId     Int?
  tahunMasuk       TahunAjaran?      @relation("TahunMasuk", fields: [tahunMasukId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tahunLulusId     Int?
  tahunLulus       TahunAjaran?      @relation("TahunLulus", fields: [tahunLulusId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  keteranganLulus  String?           @db.Text
  
  // Data Profil Alumni
  statusLanjutan       StatusLanjutan?
  namaInstansi         String?         @db.Text
  programStudi         String?
  kotaDomisiliSekarang String?
  kontakWA             String?
  email                String?

  santri           Santri            @relation(fields: [santriId], references: [id], onDelete: Cascade)
  jenjang          JenjangPendidikan @relation(fields: [jenjangId], references: [id], onDelete: Restrict)

  @@unique([santriId, jenjangId])
  @@index([jenjangId])
}

model KelasFormal {
  id            Int               @id @default(autoincrement())
  namaKelas     String
  jenjangId     Int
  jenjang       JenjangPendidikan @relation(fields: [jenjangId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  waliKelasId   Int?
  waliKelas     Guru?             @relation(fields: [waliKelasId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tahunAjaranId Int
  tahunAjaran   TahunAjaran       @relation(fields: [tahunAjaranId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  anggota       RiwayatKelas[]
  pengampu      PengampuMataPelajaran[]
  kehadiranHarian KehadiranHarianSantri[]

  @@unique([jenjangId, namaKelas, tahunAjaranId])
  @@index([waliKelasId])
  @@index([tahunAjaranId])
}

enum StatusKenaikanKelas {
  AKTIF
  NAIK_KELAS
  TINGGAL_KELAS
  LULUS
  PINDAH
  DROPOUT
}

model RiwayatKelas {
  id             Int                 @id @default(autoincrement())
  santriId       Int
  santri         Santri              @relation(fields: [santriId], references: [id], onDelete: Cascade)
  kelasFormalId  Int
  kelasFormal    KelasFormal         @relation(fields: [kelasFormalId], references: [id], onDelete: Cascade)

  statusKenaikan StatusKenaikanKelas @default(AKTIF)
  catatan        String?             @db.Text
  tanggalSelesai DateTime?
  createdAt      DateTime            @default(now())

  @@unique([santriId, kelasFormalId])
  @@index([santriId])
  @@index([kelasFormalId])
}

model ProfilPesantren {
  id            Int     @id @default(autoincrement())
  namaPesantren String
  nspp          String?
  alamatLengkap String? @db.Text
  telepon       String?
  email         String?
  website       String?
  namaPimpinan  String?
  logoUrl       String?
}

// Konfigurasi Lembaga / Sekolah Tunggal (Dinamis / White-Label)
model IdentitasLembaga {
  id                 Int      @id @default(1)
  namaLembaga        String   @default("Madrasah Aliyah Plus Al-Ittihaad")
  singkatan          String   @default("MA")
  tingkatJenjang     String   @default("MA") // MA, MTs, SMA, SMK, SMP
  sebutanSantri      String   @default("Santri") // "Santri" atau "Siswa"
  sebutanGuru        String   @default("Guru")   // "Guru" atau "Ustadz"
  
  nsm                String?
  npsn               String?
  akreditasi         String?  @default("A")
  alamat             String?  @db.Text
  kelurahan          String?
  kecamatan          String?
  kabupatenKota      String?
  provinsi           String?
  kodePos            String?
  telepon            String?
  email              String?
  website            String?
  
  logoUrl            String?  @db.Text
  iconUrl            String?  @db.Text
  kopSuratUrl        String?  @db.Text
  stempelUrl         String?  @db.Text
  ttdKepalaUrl       String?  @db.Text
  namaKepalaMadrasah String?
  nipKepalaMadrasah  String?
  templateSKL        String?  @db.Text

  waktuMulaiAbsen    String?  // HH:mm
  waktuAkhirAbsen    String?  // HH:mm

  updatedAt          DateTime @updatedAt
}

model SarprasPesantren {
  id             Int      @id @default(autoincrement())
  namaBarang     String
  kodeBarang     String?
  kategori       String?
  jumlah         Int      @default(0)
  kondisiBaik    Int      @default(0)
  kondisiRusak   Int      @default(0)
  sumberDana     String?
  tahunPerolehan Int?
  keterangan     String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SarprasJenjang {
  id             Int      @id @default(autoincrement())
  jenjangId      Int
  jenjang        JenjangPendidikan @relation(fields: [jenjangId], references: [id], onDelete: Cascade)
  namaBarang     String
  kodeBarang     String?
  kategori       String?
  jumlah         Int      @default(0)
  kondisiBaik    Int      @default(0)
  kondisiRusak   Int      @default(0)
  sumberDana     String?
  tahunPerolehan Int?
  keterangan     String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([jenjangId])
}

model MataPelajaran {
  id          Int               @id @default(autoincrement())
  nama        String
  kode        String?
  kkm         Float?
  jenjangId   Int
  jenjang     JenjangPendidikan @relation(fields: [jenjangId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  pengampu    PengampuMataPelajaran[]

  @@index([jenjangId])
}

model PengampuMataPelajaran {
  id              Int           @id @default(autoincrement())
  mataPelajaranId Int
  mataPelajaran   MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  kelasFormalId   Int
  kelasFormal     KelasFormal   @relation(fields: [kelasFormalId], references: [id], onDelete: Cascade)
  guruId          Int
  guru            Guru          @relation(fields: [guruId], references: [id], onDelete: Cascade)
  tahunAjaranId   Int
  tahunAjaran     TahunAjaran   @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)
  kkm             Float?        // KKM per kelas per mapel, diedit admin jenjang
  nilaiDirilis    Boolean       @default(false) // Toggle visibilitas nilai per mapel oleh guru/admin
  tanggalRilis    DateTime?     // Waktu rilis nilai
  jadwalPelajaran JadwalPelajaran[]
  jurnalMengajar  JurnalMengajar[]
  materiBelajar   MateriBelajar[]
  tugas           Tugas[]
  nilaiSumatif    NilaiSumatif[]
  nilaiPAS        NilaiPAS[]
  laporanSemester LaporanSemester[]

  @@unique([mataPelajaranId, kelasFormalId, tahunAjaranId])
  @@index([kelasFormalId])
  @@index([guruId])
  @@index([tahunAjaranId])
}

enum Hari {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

model JadwalPelajaran {
  id            Int                   @id @default(autoincrement())
  pengampuId    Int
  pengampu      PengampuMataPelajaran @relation(fields: [pengampuId], references: [id], onDelete: Cascade)
  semesterId    Int
  semester      Semester              @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  hari          Hari
  jamMulai      String
  jamSelesai    String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([pengampuId])
  @@index([semesterId])
}

model GuruPiket {
  id            Int               @id @default(autoincrement())
  guruId        Int
  guru          Guru              @relation(fields: [guruId], references: [id], onDelete: Cascade)
  jenjangId     Int
  jenjang       JenjangPendidikan @relation(fields: [jenjangId], references: [id], onDelete: Cascade)
  tahunAjaranId Int
  tahunAjaran   TahunAjaran       @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)
  hari          Hari
  keterangan    String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([guruId, tahunAjaranId, hari])
  @@index([guruId])
  @@index([jenjangId])
  @@index([tahunAjaranId])
}

enum TipeKartu {
  GURU
  SANTRI
}

model TemplateKartu {
  id        Int               @id @default(autoincrement())
  jenjangId Int
  jenjang   JenjangPendidikan @relation(fields: [jenjangId], references: [id], onDelete: Cascade)
  tipe      TipeKartu
  frontUrl  String?           @db.Text
  backUrl   String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([jenjangId, tipe])
  @@index([jenjangId])
}

// --- PRESENSI & E-LEARNING MODELS ---

enum StatusKehadiran {
  HADIR
  IZIN
  SAKIT
  ALPA
  TERLAMBAT
}

enum MetodeAbsensi {
  RFID
  MANUAL
}

model KehadiranGuru {
  id         Int             @id @default(autoincrement())
  guruId     Int
  guru       Guru            @relation(fields: [guruId], references: [id], onDelete: Cascade)
  semesterId Int?
  semester   Semester?       @relation(fields: [semesterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tanggal    DateTime        @db.Date
  jamMasuk   DateTime?
  jamPulang  DateTime?
  status     StatusKehadiran
  metode     MetodeAbsensi   @default(RFID)
  keterangan String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([guruId, tanggal])
  @@index([guruId])
}

model KehadiranHarianSantri {
  id            Int             @id @default(autoincrement())
  santriId      Int
  santri        Santri          @relation(fields: [santriId], references: [id], onDelete: Cascade)
  kelasFormalId Int
  kelasFormal   KelasFormal     @relation(fields: [kelasFormalId], references: [id], onDelete: Cascade)
  semesterId    Int?
  semester      Semester?       @relation(fields: [semesterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tanggal       DateTime        @db.Date
  jamMasuk      DateTime?
  jamPulang     DateTime?
  status        StatusKehadiran
  metode        MetodeAbsensi   @default(RFID)
  keterangan    String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([santriId, tanggal])
  @@index([kelasFormalId])
  @@index([santriId])
}

model JurnalMengajar {
  id            Int                   @id @default(autoincrement())
  pengampuId    Int
  pengampu      PengampuMataPelajaran @relation(fields: [pengampuId], references: [id], onDelete: Cascade)
  tanggal       DateTime              @db.Date
  materi        String                @db.Text
  catatan       String?               @db.Text
  sumatifKe     Int?                  // 1, 2, atau 3
  pertemuanKe   Int?                  // urutan pertemuan dalam sumatif (1–15)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  absensiMapel  AbsensiMapel[]

  @@index([pengampuId])
}

model AbsensiMapel {
  id                Int             @id @default(autoincrement())
  jurnalMengajarId  Int
  jurnalMengajar    JurnalMengajar  @relation(fields: [jurnalMengajarId], references: [id], onDelete: Cascade)
  santriId          Int
  santri            Santri          @relation(fields: [santriId], references: [id], onDelete: Cascade)
  status            StatusKehadiran
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([jurnalMengajarId, santriId])
  @@index([jurnalMengajarId])
  @@index([santriId])
}

enum TipeMateri {
  DOKUMEN
  VIDEO
  TEKS
}

model MateriBelajar {
  id          Int                   @id @default(autoincrement())
  pengampuId  Int
  pengampu    PengampuMataPelajaran @relation(fields: [pengampuId], references: [id], onDelete: Cascade)
  judul       String
  deskripsi   String?               @db.Text
  fileUrl     String?               @db.Text
  tipe        TipeMateri            @default(TEKS)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([pengampuId])
}

model Tugas {
  id            Int                   @id @default(autoincrement())
  pengampuId    Int
  pengampu      PengampuMataPelajaran @relation(fields: [pengampuId], references: [id], onDelete: Cascade)
  judul         String
  deskripsi     String?               @db.Text
  fileUrl       String?               @db.Text
  tenggatWaktu  DateTime?
  statusPublish Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  pengumpulan   PengumpulanTugas[]

  @@index([pengampuId])
}

model PengumpulanTugas {
  id            Int       @id @default(autoincrement())
  tugasId       Int
  tugas         Tugas     @relation(fields: [tugasId], references: [id], onDelete: Cascade)
  santriId      Int
  santri        Santri    @relation(fields: [santriId], references: [id], onDelete: Cascade)
  fileUrl       String?   @db.Text
  catatanSantri String?   @db.Text
  waktuKumpul   DateTime  @default(now())
  nilai         Int?
  keteranganGuru String?  @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tugasId, santriId])
  @@index([tugasId])
  @@index([santriId])
}

// NilaiSumatif — nilai per santri per sumatif (1/2/3) per mata pelajaran
model NilaiSumatif {
  id              Int                   @id @default(autoincrement())
  pengampuId      Int
  pengampu        PengampuMataPelajaran @relation(fields: [pengampuId], references: [id], onDelete: Cascade)
  santriId        Int
  santri          Santri                @relation(fields: [santriId], references: [id], onDelete: Cascade)
  semesterId      Int
  semester        Semester              @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  sumatifKe       Int                   // 1, 2, atau 3
  nilaiKurikuler  Float?                // input manual guru
  nilaiTesSumatif Float?                // input manual guru
  nilaiKehadiran  Float?                // input manual / hasil konversi absensi guru
  hadir           Int?                  // jumlah hadir manual (H)
  sakit           Int?                  // jumlah sakit manual (S)
  izin            Int?                  // jumlah izin manual (I)
  alfa            Int?                  // jumlah alfa manual (A)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([pengampuId, santriId, sumatifKe, semesterId])
  @@index([pengampuId])
  @@index([santriId])
  @@index([semesterId])
}

// NilaiPAS — Nilai Penilaian Akhir Semester per santri per mata pelajaran
model NilaiPAS {
  id         Int                   @id @default(autoincrement())
  pengampuId Int
  pengampu   PengampuMataPelajaran @relation(fields: [pengampuId], references: [id], onDelete: Cascade)
  santriId   Int
  santri     Santri                @relation(fields: [santriId], references: [id], onDelete: Cascade)
  semesterId Int
  semester   Semester              @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  nilai      Float?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([pengampuId, santriId, semesterId])
  @@index([pengampuId])
  @@index([santriId])
  @@index([semesterId])
}

model LaporanSemester {
  id          Int                   @id @default(autoincrement())
  santriId    Int
  santri      Santri                @relation(fields: [santriId], references: [id], onDelete: Cascade)
  semesterId  Int
  semester    Semester              @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  pengampuId  Int
  pengampu    PengampuMataPelajaran @relation(fields: [pengampuId], references: [id], onDelete: Cascade)
  nilaiAkhir  Float?
  grade       String?
  isFinalized Boolean               @default(false)
  createdAt   DateTime              @default(now())

  @@unique([santriId, pengampuId, semesterId])
  @@index([santriId])
  @@index([semesterId])
  @@index([pengampuId])
}

model LandingPageContent {
  id           Int      @id @default(1)
  heroData     Json
  statsData    Json
  featuresData Json
  profileData  Json
  contactData  Json
  footerData   Json
  updatedAt    DateTime @updatedAt
}

// --- IOT RFID ATTENDANCE MODELS ---

model PerangkatRfid {
  id            Int       @id @default(autoincrement())
  kodePerangkat String    @unique // contoh: "ESP32-GERBANG-UTAMA"
  namaPerangkat String    // "Alat Gerbang Masuk Santri"
  lokasi        String?   // "Pos Satpam Depan"
  apiKey        String    @unique // Token rahasia yang disimpan di flash ESP32
  aktif         Boolean   @default(true)
  lastPing      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PengaturanAbsensi {
  id                 Int       @id @default(autoincrement())
  jenjangId          Int?      @unique
  jamMasukMulai      String    @default("06:00") // Format HH:mm
  jamMasukBatas      String    @default("07:15") // Melebihi ini = TERLAMBAT
  jamPulangMulai     String    @default("14:30") // Batas awal tap pulang
  jamPulangSelesai   String    @default("17:30") // Batas akhir tap pulang
  toleransiTerlambat Int       @default(15)      // Toleransi menit
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model LogTapRfid {
  id            Int       @id @default(autoincrement())
  rfidUid       String
  pemilikTipe   String?   // "GURU", "SANTRI", atau "UNKNOWN"
  pemilikId     Int?
  namaPemilik   String?
  waktuTap      DateTime  @default(now())
  statusTap     String    // "BERHASIL_MASUK", "BERHASIL_PULANG", "KARTU_TIDAK_TERDAFTAR", "DOUBLE_TAP"
  kodePerangkat String?

  @@index([waktuTap])
  @@index([rfidUid])
}

enum TipeLibur {
  MINGGUAN
  KONDISIONAL
  SEMESTER
}

model HariLibur {
  id           Int                @id @default(autoincrement())
  tipe         TipeLibur
  nama         String             // Nama / keterangan libur
  hariMingguan Hari?              // Untuk tipe MINGGUAN (misal: MINGGU, JUMAT, SABTU)
  tanggal      DateTime?          @db.Date // Untuk tipe KONDISIONAL (tanggal tertentu)
  tanggalMulai DateTime?          @db.Date // Untuk tipe SEMESTER (rentang mulai)
  tanggalAkhir DateTime?          @db.Date // Untuk tipe SEMESTER (rentang akhir)
  keterangan   String?            @db.Text
  jenjangId    Int?               // null = Berlaku untuk Semua Jenjang
  jenjang      JenjangPendidikan? @relation(fields: [jenjangId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([tipe])
  @@index([tanggal])
  @@index([jenjangId])
}

